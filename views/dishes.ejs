<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <style>
    body { font-family: sans-serif; margin: 20px; }
    h1 { color: #333; }
    .rest-info { color: #777; margin-bottom: 20px;}
    table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    th, td { text-align: left; padding: 12px; border-bottom: 1px solid #ddd; vertical-align: middle; }
    th { background-color: #f2f2f2; }
    .dish-img { width: 80px; height: 80px; object-fit: cover; border-radius: 4px; background-color: #eee; display: inline-block;}
    .actions a { text-decoration: none; margin-right: 10px; padding: 5px 10px; border-radius: 4px; }
    .btn-edit { background-color: #2196F3; color: white; }
    .btn-delete { background-color: #f44336; color: white; }
    .btn-add { display: inline-block; padding: 10px 15px; background-color: #555; color: white; text-decoration: none; border-radius: 4px; margin-bottom: 20px;}
    .btn-back { display: block; margin-bottom: 20px; color: #555; }
  </style>
</head>
<body>
  <a href="/" class="btn-back">← Volver a todos los restaurantes</a>
  <h1>Platos de: <%= restaurant.nombre %></h1>
  <div class="rest-info">Dirección: <%= restaurant.direccion %></div>
  
  <a href="/restaurants/<%= restaurant.id_restaurante %>/dishes/add" class="btn-add">+ Añadir Plato</a>
  
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Imagen</th>
        <th>Nombre del Plato</th>
        <th>Precio</th>
        <th>Categoría</th> 
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% dishes.forEach(dish => { %>
        <tr>
          <td><%= dish.id_plato %></td>
          <td>
            <% if (dish.imagen) { %>
              <img src="/uploads/<%= dish.imagen %>" alt="<%= dish.nombre %>" class="dish-img">
            <% } else { %>
              <div class="dish-img">No Image</div>
            <% } %>
          </td>
          <td><%= dish.nombre %></td>
          <td>S/ <%= parseFloat(dish.precio).toFixed(2) %></td>
          <td><%= dish.nombre_restaurante %></td> 
          <td class="actions">
            <a href="/dishes/edit/<%= dish.id_plato %>" class="btn-edit">Editar</a>
            <a href="/dishes/delete/<%= dish.id_plato %>" class="btn-delete" onclick="return confirm('¿Seguro?')">Eliminar</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>